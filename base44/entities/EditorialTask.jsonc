{
  "name": "EditorialTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "canonical_uid": {
      "type": "string"
    },
    "object_title": {
      "type": "string"
    },
    "object_type": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "seo",
        "research",
        "quiz",
        "tutorial",
        "relationship",
        "code",
        "content",
        "metadata",
        "reference"
      ],
      "default": "content"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "priority_score": {
      "type": "number",
      "default": 0
    },
    "reason": {
      "type": "string"
    },
    "missing_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "review",
        "complete"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string"
    },
    "ai_draft": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "canonical_uid",
    "task_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    }
  }
}