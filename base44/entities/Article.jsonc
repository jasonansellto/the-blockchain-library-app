{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "featured_image": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "toc": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "level": {
            "type": "number"
          }
        }
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "beginner"
    },
    "reading_time": {
      "type": "number"
    },
    "author_id": {
      "type": "string"
    },
    "author_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category_id": {
      "type": "string"
    },
    "subcategory_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "public",
        "premium"
      ],
      "default": "public"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "related_articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_glossary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_research": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_external": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "internal_id": {
      "type": "string"
    },
    "og_image": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "schema_type": {
      "type": "string"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "citation": {
      "type": "string"
    },
    "health_score": {
      "type": "number",
      "default": 0
    },
    "geo_score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug",
    "status"
  ]
}