{
  "name": "ResearchPaper",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abstract": {
      "type": "string"
    },
    "publication": {
      "type": "string"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "doi": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "bibtex": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "research_type": {
      "type": "string",
      "enum": [
        "paper",
        "thesis",
        "report",
        "whitepaper",
        "preprint"
      ],
      "default": "paper"
    },
    "downloads": {
      "type": "number",
      "default": 0
    },
    "citations_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "related_articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_glossary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "internal_id": {
      "type": "string"
    },
    "og_image": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "schema_type": {
      "type": "string"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "author_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    }
  }
}