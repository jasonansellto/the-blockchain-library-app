{
  "name": "ResearchPaper",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abstract": {
      "type": "string"
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "intermediate"
    },
    "is_original_research": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "publication": {
      "type": "string"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "doi": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "bibtex": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "research_type": {
      "type": "string",
      "enum": [
        "paper",
        "thesis",
        "report",
        "whitepaper",
        "preprint",
        "standard"
      ],
      "default": "paper"
    },
    "downloads": {
      "type": "number",
      "default": 0
    },
    "citations_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "related_articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_glossary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "internal_id": {
      "type": "string"
    },
    "og_image": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "schema_type": {
      "type": "string"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "author_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "slug"
  ]
}