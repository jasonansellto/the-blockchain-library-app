{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "isbn_ebook": {
      "type": "string"
    },
    "isbn_paperback": {
      "type": "string"
    },
    "isbn_hardcover": {
      "type": "string"
    },
    "isbn_audiobook": {
      "type": "string"
    },
    "kindle_asin": {
      "type": "string"
    },
    "audible_asin": {
      "type": "string"
    },
    "amazon_link": {
      "type": "string"
    },
    "amazon_kindle_link": {
      "type": "string"
    },
    "official_website": {
      "type": "string"
    },
    "publisher_page": {
      "type": "string"
    },
    "google_books_url": {
      "type": "string"
    },
    "audible_url": {
      "type": "string"
    },
    "access_links": {
      "type": "object",
      "properties": {
        "kindle_url": {
          "type": "string"
        },
        "paperback_url": {
          "type": "string"
        },
        "hardcover_url": {
          "type": "string"
        },
        "audible_url": {
          "type": "string"
        },
        "google_books_url": {
          "type": "string"
        },
        "official_website": {
          "type": "string"
        },
        "publisher_page": {
          "type": "string"
        }
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "string"
    },
    "publication_year": {
      "type": "number"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "reading_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "beginner"
    },
    "author_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "pages": {
      "type": "number"
    },
    "language": {
      "type": "string",
      "default": "English"
    },
    "series": {
      "type": "string"
    },
    "reading_order": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_learnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chapter_overview": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_title": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "related_articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_glossary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_research": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "published"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "internal_id": {
      "type": "string"
    },
    "og_image": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "schema_type": {
      "type": "string"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "citation": {
      "type": "string"
    },
    "citation_bibtex": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    }
  }
}