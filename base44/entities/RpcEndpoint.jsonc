{
  "name": "RpcEndpoint",
  "type": "object",
  "properties": {
    "network": {
      "type": "string"
    },
    "chain_id": {
      "type": "number"
    },
    "provider": {
      "type": "string"
    },
    "endpoint_url": {
      "type": "string"
    },
    "auth_required": {
      "type": "boolean",
      "default": false
    },
    "slug": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_recommended": {
      "type": "boolean",
      "default": false
    },
    "region": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "mainnet",
        "testnet"
      ],
      "default": "mainnet"
    }
  },
  "required": [
    "network",
    "provider",
    "endpoint_url",
    "slug"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    }
  }
}