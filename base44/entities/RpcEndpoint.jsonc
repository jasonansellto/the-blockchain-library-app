{
  "name": "RpcEndpoint",
  "type": "object",
  "properties": {
    "network": {
      "type": "string"
    },
    "chain_id": {
      "type": "number"
    },
    "provider": {
      "type": "string"
    },
    "endpoint_url": {
      "type": "string"
    },
    "auth_required": {
      "type": "boolean",
      "default": false
    },
    "slug": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_recommended": {
      "type": "boolean",
      "default": false
    },
    "region": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "mainnet",
        "testnet"
      ],
      "default": "mainnet"
    }
  },
  "required": [
    "network",
    "provider",
    "endpoint_url",
    "slug"
  ]
}