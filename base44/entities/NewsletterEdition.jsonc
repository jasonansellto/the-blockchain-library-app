{
  "name": "NewsletterEdition",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "issue_number": {
      "type": "number"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "slug",
    "published_date"
  ]
}