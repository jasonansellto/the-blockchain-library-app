{
  "name": "Weekly Newsletter Generation",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Toronto",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Auto-generates a newsletter edition from recent articles every Monday at 9am ET",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_newsletter",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_edition": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateNewsletterEdition",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Generate newsletter edition",
            "description": "Auto-create from recent articles"
          }
        }
      }
    ]
  }
}